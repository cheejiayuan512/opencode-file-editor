{
  "name": "opencode-file-editor",
  "version": "0.5.2",
  "description": "A file editor panel for OpenCode Desktop: tabs, autosave, external-change protection, and Markdown preview.",
  "type": "module",
  "author": "JIAYUAN",
  "files": [
    "index.ts",
    "gui-experimental.cjs",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "editor",
    "file-editor",
    "markdown",
    "desktop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheejiayuan512/opencode-file-editor.git"
  },
  "homepage": "https://github.com/cheejiayuan512/opencode-file-editor#readme",
  "bugs": {
    "url": "https://github.com/cheejiayuan512/opencode-file-editor/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "build:tests": "node scripts/build-tests.mjs",
    "pretest": "npm run build",
    "test": "npm run build:tests && node --test test/*.test.mjs",
    "test:fuzz": "npm run build:tests && node --test \"test/property-*.test.mjs\"",
    "test:coverage": "npm run build:tests && node --test --experimental-test-coverage --test-coverage-exclude=\"test/*.test.mjs\" --test-coverage-exclude=\"test/fixtures/**\" \"test/*.test.mjs\"",
    "verify:live": "node scripts/verify-live.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.20.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "solid-js": "^2.0.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.0"
  }
}
